# Copy this file to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for the live site.
# Never commit real values.

# Your live site address (used for share previews and the sitemap)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Neon Postgres connection string (saves contact messages)
DATABASE_URL=

# Resend API key (emails you each contact message)
RESEND_API_KEY=
# Optional: who the email goes to, and who it comes from
CONTACT_TO=pooja.work102@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Cloudflare Turnstile spam check (optional; the form works without it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string; used to hash visitor IPs for rate limiting
IP_HASH_SALT=

# Optional: GitHub token with no scopes, raises the API limit for the stats card
GITHUB_TOKEN=
